# Скопируй этот файл и переименуй в .env
# Внутрь вставь токен, полученный от @BotFather в Telegram
BOT_TOKEN=сюда_вставь_токен_от_BotFather

# Telegram ID админов (можно несколько через запятую).
# Свой ID можно узнать у бота @userinfobot
# Только админы могут банить и видеть жалобы.
ADMIN_IDS=

# Обязательные каналы для подписки (через запятую, БЕЗ пробелов).
# Бот должен быть админом в каждом канале!
# Примеры:
#   REQUIRED_CHANNELS=@channel1,@channel2
#   REQUIRED_CHANNELS=@christiancomuna,@christian7family
# Если пусто — проверка подписки выключена.
REQUIRED_CHANNELS=
