# Скопируй этот файл и переименуй в .env
# Внутрь вставь токен, полученный от @BotFather в Telegram
BOT_TOKEN=сюда_вставь_токен_от_BotFather

# Telegram ID админов (можно несколько через запятую).
# Свой ID можно узнать у бота @userinfobot
# Только админы могут банить и видеть жалобы.
ADMIN_IDS=

# Обязательные каналы для подписки (через запятую, БЕЗ пробелов).
# Бот должен быть админом в каждом канале!
# Если пусто — проверка подписки выключена.
REQUIRED_CHANNELS=

# ====== ВКонтакте (опционально) ======
# Токен сообщества из Управление → Работа с API → Ключи доступа.
# Если пусто — VK-бот не запустится, Telegram продолжит работать.
VK_TOKEN=

# ID сообщества (только число, без минуса). Из URL: vk.com/club184607335 → 184607335
VK_GROUP_ID=

# Обязательное сообщество для подписки в ВК (только короткое имя без @).
# Например: kovcheg_znakomstva. Если пусто — проверка не делается.
VK_REQUIRED_GROUP=
